{
  "name": "world-monitor",
  "version": "1.0.0",
  "description": "Real-time global intelligence desktop dashboard",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"webpack serve --mode development\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "webpack --mode production",
    "electron": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.worldmonitor.app",
    "productName": "World Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "main.js",
      "preload.js",
      "public/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "WorldMonitor-${version}-Portable.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:31338/git/tommccullagh/world-monitor"
  },
  "keywords": ["intelligence", "geopolitical", "military", "monitoring"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.3",
    "discord.js": "^14.25.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "html-webpack-plugin": "^5.6.6",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.4",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
